<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Files" Manufacturer="Files Community (self-built)" Version="4.3.0" UpgradeCode="8F3C2A10-5B7D-4E9A-9C11-6D2E4F8A0B33" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Files is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Files" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Files" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <Feature Id="Main" Title="Files" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Fragment>
      <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="A1B2C3D4-1111-4E9A-9C11-6D2E4F8A0B33">
        <Shortcut Id="FilesStartMenu" Name="Files" Target="[INSTALLFOLDER]Files.App.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\FilesCommunity\Files" Name="startmenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="A1B2C3D4-2222-4E9A-9C11-6D2E4F8A0B33">
        <Shortcut Id="FilesDesktop" Name="Files" Target="[INSTALLFOLDER]Files.App.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\FilesCommunity\Files" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Fragment>

    <UI>
      <UIRef Id="WixUI_InstallDir" />
    </UI>
  </Package>
</Wix>
